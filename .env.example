# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# Server-side only, and only for scripts/import-bank.ts. Never referenced by
# the app and never shipped to the browser -- anything VITE_-prefixed is, this
# deliberately is not. Supabase dashboard -> Project Settings -> API Keys.
# Leave unset unless you are running the one-off bank import.
SUPABASE_SERVICE_ROLE_KEY=

# Test deployment only (kaxx4/shikshaqkanitest on Vercel). Leave UNSET for the
# live site: with it unset the preview role toggle is not merely hidden, it is
# tree-shaken out of the bundle entirely. See CLAUDE.md.
# VITE_PREVIEW_TOOLS=true
# VITE_PREVIEW_STUDENT_EMAIL=preview-student@preview.shikshaq.in
# VITE_PREVIEW_STUDENT_PASSWORD=
# VITE_PREVIEW_TEACHER_EMAIL=preview-teacher@preview.shikshaq.in
# VITE_PREVIEW_TEACHER_PASSWORD=
